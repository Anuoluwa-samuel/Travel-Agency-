# ORBIS — environment template. Copy to .env.local and fill in. Never commit real values.
# Required values are marked [required]. Optional integrations fall back safely when empty
# (see docs/integrations.md).

NODE_ENV=development
# Deployment tier: development | staging | production. Production enforces S3 storage and
# transactional email at startup, and the seed script refuses to run outside development.
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# [required] PostgreSQL. Matches docker-compose.yml for local development (no password:
# the local container only accepts connections from this machine). Use a password in every
# hosted environment.
DATABASE_URL=postgres://orbis@localhost:5544/orbis
# Used only by the integration test suite (separate database, wiped between runs).
TEST_DATABASE_URL=postgres://orbis@localhost:5544/orbis_test

# [required] Auth. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# [required] 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts passport numbers and dates of birth. Losing it makes that data unreadable.
DATA_ENCRYPTION_KEY=

# Payments — Paystack (use test keys locally)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email — Resend. Empty in development = emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="ORBIS <hello@example.com>"

# Storage — "local" stores files under .storage/ (development only); "s3" for S3/R2.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=

# AI trip planner — Anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Protects /api/cron/* endpoints
CRON_SECRET=

# Observability
SENTRY_DSN=
